#!/usr/bin/env bash
set -euo pipefail

CONTAINER="ark-development"

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Required command not found: $1" >&2
        exit 1
    }
}

as_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    else
        require_command sudo
        sudo "$@"
    fi
}

next_subid_range() {
    local database="$1"
    local first=100000
    local last
    while true; do
        last=$((first + 65535))
        if ! awk -F: -v first="$first" -v last="$last" '$2 <= last && ($2 + $3 - 1) >= first { found=1 } END { exit !found }' "$database" 2>/dev/null; then
            printf '%s-%s' "$first" "$last"
            return
        fi
        first=$((first + 65536))
    done
}

ensure_subid_mapping() {
    local database="$1"
    local option="$2"
    if ! awk -F: -v user="$USER" '$1 == user { found=1 } END { exit !found }' "$database" 2>/dev/null; then
        local range
        range=$(next_subid_range "$database")
        as_root usermod "$option" "$range" "$USER"
    fi
}

configure_rootless_podman_ids() {
    [[ $EUID -ne 0 ]] || {
        echo "Run 'ark development enable' as your normal desktop user, not as root." >&2
        exit 1
    }
    ensure_subid_mapping /etc/subuid --add-subuids
    ensure_subid_mapping /etc/subgid --add-subgids
}

container_exists() {
    distrobox list --no-color 2>/dev/null | grep -Fq "$CONTAINER"
}

install_toolchain() {
    distrobox enter --name "$CONTAINER" -- bash -lc '
        set -euo pipefail
        sudo pacman -Syu --needed --noconfirm \
            base-devel git git-lfs github-cli nodejs npm \
            python python-pip rustup cmake ninja clang pkgconf gdb lldb valgrind strace shellcheck shfmt jq ripgrep fd tree
        if ! rustup show active-toolchain >/dev/null 2>&1; then
            rustup default stable
        fi
        rustup component add rustfmt clippy
        git lfs install
    '
}

install_agents() {
    # These vendor installers install user-scoped executables/configuration.
    # Credentials and agent state remain in the user's home, not the image.
    require_command curl
    curl -fsSL https://claude.ai/install.sh | bash
    curl -fsSL https://chatgpt.com/codex/install.sh | sh
}

case "${1:-status}" in
    enable)
        require_command distrobox
        require_command podman
        configure_rootless_podman_ids
        if ! container_exists; then
            echo "Creating the Ark development toolchain container..."
            distrobox create --name "$CONTAINER" \
                --image docker.io/library/archlinux:latest --yes
        fi
        install_toolchain
        install_agents
        echo "Ark development environment is ready."
        echo "Claude Code and Codex are installed for this user."
        ;;
    shell)
        require_command distrobox
        container_exists || {
            echo "Ark development is not enabled. Run 'ark development enable' first." >&2
            exit 1
        }
        distrobox enter --name "$CONTAINER"
        ;;
    update)
        require_command distrobox
        container_exists || {
            echo "Ark development is not enabled. Run 'ark development enable' first." >&2
            exit 1
        }
        install_toolchain
        install_agents
        ;;
    disable)
        require_command distrobox
        if container_exists; then
            echo "Removing the Ark development container..."
            distrobox stop "$CONTAINER" 2>/dev/null || true
            distrobox rm "$CONTAINER" --force
        else
            echo "Ark development container is already disabled."
        fi
        echo "User projects, Claude/Codex credentials, and home-directory configuration are retained."
        echo "The user-installed Claude Code and Codex executables are not removed."
        ;;
    status)
        require_command distrobox
        if container_exists; then
            echo "Ark development container: present"
            distrobox list --no-color | grep -F "$CONTAINER" || true
            distrobox enter --name "$CONTAINER" -- bash -lc '
                for tool in git gh node npm python rustc cargo cmake ninja clang; do
                    if command -v "$tool" >/dev/null 2>&1; then
                        printf "%s: available in development container\\n" "$tool"
                    else
                        printf "%s: missing from development container\\n" "$tool"
                    fi
                done
            '
        else
            echo "Ark development container: absent"
        fi
        for tool in claude codex; do
            if command -v "$tool" >/dev/null 2>&1; then
                printf '%s: available on host PATH\\n' "$tool"
            else
                printf '%s: not installed for this user\\n' "$tool"
            fi
        done
        ;;
    *)
        echo "Usage: ark development {enable|disable|status|update}" >&2
        exit 2
        ;;
esac
