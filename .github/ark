#!/usr/bin/env bash
set -euo pipefail

APP_ID_STEAM="com.valvesoftware.Steam"

usage() {
    cat <<'EOF'
Ark feature manager

Usage:
  ark feature list
  ark feature status [FEATURE]
  ark feature enable FEATURE
  ark feature disable FEATURE
  ark feature unregister github-runner
  ark steam|tailscale|podman|distrobox|github-runner status|enable|disable

Manageable features:
  steam          Install or remove Steam as a system Flatpak.
  tailscale      Enable or disable the Tailscale system service.
  podman         Enable or disable the rootless Podman API socket.
  github-runner  Register and run a repository-scoped self-hosted runner.

Included base capabilities:
  distrobox      Already included in Ark desktop images; no daemon to enable.

Examples:
  ark steam enable
  ark tailscale enable
  ark podman enable
  ark github-runner enable
EOF
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Required command not found: $1" >&2
        exit 1
    }
}

as_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    else
        require_command sudo
        sudo "$@"
    fi
}

steam_action() {
    require_command flatpak
    case "$1" in
        enable)
            echo "Installing Steam system-wide from Flathub..."
            as_root flatpak install --system --noninteractive --assumeyes flathub "$APP_ID_STEAM"
            ;;
        disable)
            if flatpak info --system "$APP_ID_STEAM" >/dev/null 2>&1; then
                echo "Removing the Steam application. User data is not deliberately deleted."
                as_root flatpak uninstall --system --noninteractive --assumeyes "$APP_ID_STEAM"
            else
                echo "Steam is not installed."
            fi
            ;;
        status)
            if flatpak info --system "$APP_ID_STEAM" >/dev/null 2>&1; then
                echo "Steam: installed (system Flatpak)"
            else
                echo "Steam: not installed"
            fi
            ;;
    esac
}

tailscale_action() {
    require_command systemctl
    case "$1" in
        enable)
            require_command tailscale
            echo "Starting Tailscale. You may be asked to authenticate with your tailnet."
            as_root systemctl enable --now tailscaled.service
            if ! as_root tailscale status >/dev/null 2>&1; then
                as_root tailscale up
            else
                as_root tailscale status
            fi
            ;;
        disable)
            if command -v tailscale >/dev/null 2>&1; then
                as_root tailscale down || true
            fi
            as_root systemctl disable --now tailscaled.service
            ;;
        status)
            if systemctl is-active --quiet tailscaled.service; then
                echo "Tailscale service: active"
                as_root tailscale status || true
            else
                echo "Tailscale service: inactive"
            fi
            ;;
    esac
}

podman_action() {
    require_command podman
    require_command systemctl
    case "$1" in
        enable)
            echo "Enabling the rootless Podman API socket for the current user..."
            systemctl --user enable --now podman.socket
            ;;
        disable)
            systemctl --user disable --now podman.socket
            ;;
        status)
            if systemctl --user is-active --quiet podman.socket; then
                echo "Podman API socket: active"
            else
                echo "Podman API socket: inactive (Podman CLI remains available)"
            fi
            ;;
    esac
}

distrobox_action() {
    require_command distrobox
    case "$1" in
        status)
            echo "Distrobox: installed in the Ark desktop base image"
            echo "Distrobox is a user command, not a background service."
            ;;
        enable)
            echo "Distrobox is already included and ready to use."
            ;;
        disable)
            echo "Distrobox is part of the immutable base image and cannot be removed independently." >&2
            echo "It can be omitted from a future custom image build." >&2
            exit 2
            ;;
    esac
}

github_runner_action() {
    local action="$1"
    local runner_dir="$HOME/.local/opt/ark-github-runner"
    local unit_dir="$HOME/.config/systemd/user"
    local unit_file="$unit_dir/ark-github-runner.service"

    require_command systemctl
    case "$action" in
        status)
            if [[ -f "$runner_dir/.runner" ]]; then
                echo "GitHub Actions runner: configured"
                systemctl --user status ark-github-runner.service --no-pager || true
            else
                echo "GitHub Actions runner: not configured"
            fi
            ;;
        enable)
            if [[ -f "$runner_dir/.runner" ]]; then
                systemctl --user enable --now ark-github-runner.service
                echo "GitHub Actions runner started."
                return
            fi
            require_command curl
            require_command jq
            require_command tar
            [[ "$(uname -m)" == "x86_64" ]] || {
                echo "The initial Ark runner setup supports x86_64 hosts only." >&2
                exit 2
            }

            local repo_url token asset_url runner_name
            read -r -p "GitHub repository URL (https://github.com/OWNER/REPO): " repo_url
            [[ "$repo_url" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$ ]] || {
                echo "Enter a valid GitHub repository URL." >&2
                exit 2
            }
            read -r -s -p "Short-lived runner registration token: " token
            echo
            [[ -n "$token" ]] || { echo "A registration token is required." >&2; exit 2; }

            asset_url=$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest |
                jq -er '[.assets[] | select(.name | test("^actions-runner-linux-x64-[0-9.]+\\.tar\\.gz$"))][0].browser_download_url')
            mkdir -p "$runner_dir" "$unit_dir"
            curl -fL --retry 3 "$asset_url" -o "$runner_dir/runner.tar.gz"
            tar -xzf "$runner_dir/runner.tar.gz" -C "$runner_dir"
            rm -f "$runner_dir/runner.tar.gz"
            runner_name="ark-builder-$(hostname -s)"
            (
                cd "$runner_dir"
                ./config.sh --unattended --url "$repo_url" --token "$token" \
                    --name "$runner_name" --labels "ark-builder" --work "_work" --replace
            )
            unset token
            chmod 600 "$runner_dir"/.credentials* 2>/dev/null || true

            cat > "$unit_file" <<'EOF'
[Unit]
Description=Ark GitHub Actions Self-hosted Runner
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/.local/opt/ark-github-runner
ExecStart=%h/.local/opt/ark-github-runner/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
EOF
            systemctl --user daemon-reload
            systemctl --user enable --now ark-github-runner.service
            if command -v loginctl >/dev/null 2>&1; then
                echo "Enabling user lingering so the runner can start without an interactive login."
                as_root loginctl enable-linger "$USER" ||
                    echo "Warning: enable lingering manually if the runner must start before you log in."
            fi
            echo "Runner registered with label ark-builder."
            echo "Only use this runner for trusted workflows from repositories you control."
            ;;
        disable)
            systemctl --user disable --now ark-github-runner.service
            echo "Runner stopped. Its registration is retained."
            ;;
        unregister)
            [[ -f "$runner_dir/.runner" ]] || { echo "Runner is not configured."; return; }
            read -r -s -p "Short-lived runner removal token: " token
            echo
            [[ -n "$token" ]] || { echo "A removal token is required." >&2; exit 2; }
            systemctl --user disable --now ark-github-runner.service || true
            (cd "$runner_dir" && ./config.sh remove --unattended --token "$token")
            unset token
            rm -f "$unit_file"
            systemctl --user daemon-reload
            echo "Runner unregistered. Downloaded runner files were retained."
            ;;
    esac
}

run_feature() {
    local action="$1"
    local feature="$2"
    case "$feature" in
        steam) steam_action "$action" ;;
        tailscale) tailscale_action "$action" ;;
        podman) podman_action "$action" ;;
        distrobox) distrobox_action "$action" ;;
        github-runner) github_runner_action "$action" ;;
        *) echo "Unknown feature: $feature" >&2; usage; exit 2 ;;
    esac
}

feature_action() {
    local action="$1"
    local feature="${2:-}"
    case "$action" in
        list)
            cat <<'EOF'
Manageable:
  steam          Optional system-wide Flatpak
  tailscale      Optional system service
  podman         Optional rootless API socket
  github-runner  Optional repository-scoped runner service

Included in the desktop base:
  distrobox      Always available; no service toggle
EOF
            ;;
        status)
            if [[ -n "$feature" ]]; then
                run_feature status "$feature"
            else
                steam_action status
                tailscale_action status
                podman_action status
                distrobox_action status
                github_runner_action status
            fi
            ;;
        enable|disable|unregister)
            [[ -n "$feature" ]] || { echo "Specify a feature." >&2; usage; exit 2; }
            run_feature "$action" "$feature"
            ;;
        *)
            usage
            exit 2
            ;;
    esac
}

if [[ $# -eq 0 ]]; then
    usage
    exit 0
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    usage
    exit 0
fi

if [[ "$1" == "feature" ]]; then
    shift
    [[ $# -ge 1 ]] || { usage; exit 2; }
    feature_action "$@"
    exit $?
fi

feature="$1"
action="${2:-status}"
case "$action" in
    status|enable|disable|unregister) ;;
    *) usage; exit 2 ;;
esac

run_feature "$action" "$feature"
