#!/usr/bin/env bash
set -euo pipefail

APP_ID_STEAM="com.valvesoftware.Steam"
APP_ID_SUNSHINE="dev.lizardbyte.sunshine"

usage() {
    cat <<'EOF'
Lydsys System Manager

Usage:
  lydsys feature list
  lydsys feature status [FEATURE]
  lydsys feature enable FEATURE
  lydsys feature disable FEATURE
  lydsys feature unregister github-runner
  lydsys steam|tailscale|podman|distrobox|github-runner|solaar|sunshine|printing|development|virtualization ACTION [ARGS]

Manageable features:
  steam          Install or remove Steam through Pacman in the Arch Distrobox.
  tailscale      Enable or disable the Tailscale system service.
  podman         Enable or disable the rootless Podman API socket.
  github-runner  Register and run a repository-scoped self-hosted runner.
  solaar         Enable or disable the Logitech device manager tray app.
  sunshine       Install and run the Sunshine game-streaming host.
  printing      Enable or disable printing and scanner services.
  development    Create a containerized coding toolchain and install Claude Code/Codex.
  virtualization Manage local QEMU/KVM virtual machines through libvirt.

Included base capabilities:
  distrobox      Already included in Ark desktop images; no daemon to enable.

Examples:
  lydsys steam enable
  lydsys tailscale enable
  lydsys podman enable
  lydsys github-runner enable
  lydsys solaar enable
  lydsys sunshine enable
  lydsys printing enable
  lydsys development enable
  lydsys development shell
  lydsys virtualization enable
  lydsys virtualization list
  lydsys virtualization start my-vm
EOF
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Required command not found: $1" >&2
        exit 1
    }
}

as_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    else
        require_command sudo
        sudo "$@"
    fi
}

steam_container_exists() {
    distrobox list 2>/dev/null | grep -Eq '(^|[[:space:]])archlinux([[:space:]]|$)'
}

prepare_steam_container() {
    require_command distrobox
    require_command pacman

    # A harmless query initializes Carrier's per-user Arch Distrobox if needed.
    pacman -Q pacman >/dev/null 2>&1 || {
        echo "Unable to initialize the Arch package container." >&2
        return 1
    }

    # Steam is in Arch's multilib repository, which is disabled by default.
    distrobox enter archlinux -- sudo sh -c '
        set -e
        if grep -q "^#\\[multilib\\]" /etc/pacman.conf; then
            sed -i "/^#\\[multilib\\]/,/^#Include =/s/^#//" /etc/pacman.conf
        elif ! grep -q "^\\[multilib\\]" /etc/pacman.conf; then
            printf "\\n[multilib]\\nInclude = /etc/pacman.d/mirrorlist\\n" >> /etc/pacman.conf
        fi
    '
}

remove_legacy_steam_flatpak() {
    if command -v flatpak >/dev/null 2>&1 && flatpak info --system "$APP_ID_STEAM" >/dev/null 2>&1; then
        echo "Removing the previous system Flatpak installation; its user data is retained."
        as_root flatpak uninstall --system --noninteractive --assumeyes "$APP_ID_STEAM"
    fi
}

steam_action() {
    require_command distrobox
    require_command pacman
    case "$1" in
        enable)
            prepare_steam_container
            echo "Installing Steam from Arch's multilib repository through Carrier..."
            as_root pacman -Syu --needed --noconfirm steam
            remove_legacy_steam_flatpak
            echo "Steam is installed through Pacman in the Arch Distrobox."
            echo "Choose 'A' at the Carrier export prompt to add Steam to the application launcher."
            ;;
        disable)
            local removed=0
            if steam_container_exists && pacman -Q steam >/dev/null 2>&1; then
                echo "Removing the Pacman Steam package. User data is retained."
                as_root pacman -Rns --noconfirm steam
                removed=1
            fi
            if command -v flatpak >/dev/null 2>&1 && flatpak info --system "$APP_ID_STEAM" >/dev/null 2>&1; then
                echo "Removing the legacy system Flatpak Steam installation; user data is retained."
                as_root flatpak uninstall --system --noninteractive --assumeyes "$APP_ID_STEAM"
                removed=1
            fi
            if ((removed == 0)); then
                echo "Steam is not installed."
            fi
            ;;
        status)
            local installed=0
            if steam_container_exists && pacman -Q steam >/dev/null 2>&1; then
                echo "Steam: installed (Pacman in the Arch Distrobox)"
                installed=1
            fi
            if command -v flatpak >/dev/null 2>&1 && flatpak info --system "$APP_ID_STEAM" >/dev/null 2>&1; then
                echo "Steam: installed (legacy system Flatpak)"
                installed=1
            fi
            if ((installed == 0)); then
                echo "Steam: not installed"
            fi
            ;;
        *)
            echo "Usage: lydsys steam {enable|disable|status}" >&2
            return 2
            ;;
    esac
}

tailscale_action() {
    require_command systemctl
    case "$1" in
        enable)
            require_command tailscale
            echo "Starting Tailscale. You may be asked to authenticate with your tailnet."
            as_root systemctl enable --now tailscaled.service
            if ! as_root tailscale status >/dev/null 2>&1; then
                as_root tailscale up
            else
                as_root tailscale status
            fi
            ;;
        disable)
            if command -v tailscale >/dev/null 2>&1; then
                as_root tailscale down || true
            fi
            as_root systemctl disable --now tailscaled.service
            ;;
        status)
            if systemctl is-active --quiet tailscaled.service; then
                echo "Tailscale service: active"
                as_root tailscale status || true
            else
                echo "Tailscale service: inactive"
            fi
            ;;
    esac
}

podman_action() {
    require_command podman
    require_command systemctl
    case "$1" in
        enable)
            echo "Enabling the rootless Podman API socket for the current user..."
            systemctl --user enable --now podman.socket
            ;;
        disable)
            systemctl --user disable --now podman.socket
            ;;
        status)
            if systemctl --user is-active --quiet podman.socket; then
                echo "Podman API socket: active"
            else
                echo "Podman API socket: inactive (Podman CLI remains available)"
            fi
            ;;
    esac
}

distrobox_action() {
    require_command distrobox
    case "$1" in
        status)
            echo "Distrobox: installed in the Ark desktop base image"
            echo "Distrobox is a user command, not a background service."
            ;;
        enable)
            echo "Distrobox is already included and ready to use."
            ;;
        disable)
            echo "Distrobox is part of the immutable base image and cannot be removed independently." >&2
            echo "It can be omitted from a future custom image build." >&2
            exit 2
            ;;
    esac
}

github_runner_action() {
    local action="$1"
    local runner_dir="$HOME/.local/opt/ark-github-runner"
    local unit_dir="$HOME/.config/systemd/user"
    local unit_file="$unit_dir/ark-github-runner.service"

    require_command systemctl
    case "$action" in
        status)
            if [[ -f "$runner_dir/.runner" ]]; then
                echo "GitHub Actions runner: configured"
                systemctl --user status ark-github-runner.service --no-pager || true
            else
                echo "GitHub Actions runner: not configured"
            fi
            ;;
        enable)
            if [[ -f "$runner_dir/.runner" ]]; then
                systemctl --user enable --now ark-github-runner.service
                echo "GitHub Actions runner started."
                return
            fi
            require_command curl
            require_command jq
            require_command tar
            [[ "$(uname -m)" == "x86_64" ]] || {
                echo "The initial Ark runner setup supports x86_64 hosts only." >&2
                exit 2
            }

            local repo_url token asset_url runner_name
            read -r -p "GitHub repository URL (https://github.com/OWNER/REPO): " repo_url
            [[ "$repo_url" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$ ]] || {
                echo "Enter a valid GitHub repository URL." >&2
                exit 2
            }
            read -r -s -p "Short-lived runner registration token: " token
            echo
            [[ -n "$token" ]] || { echo "A registration token is required." >&2; exit 2; }

            asset_url=$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest |
                jq -er '[.assets[] | select(.name | test("^actions-runner-linux-x64-[0-9.]+\\.tar\\.gz$"))][0].browser_download_url')
            mkdir -p "$runner_dir" "$unit_dir"
            curl -fL --retry 3 "$asset_url" -o "$runner_dir/runner.tar.gz"
            tar -xzf "$runner_dir/runner.tar.gz" -C "$runner_dir"
            rm -f "$runner_dir/runner.tar.gz"
            runner_name="ark-builder-$(hostname -s)"
            (
                cd "$runner_dir"
                ./config.sh --unattended --url "$repo_url" --token "$token" \
                    --name "$runner_name" --labels "ark-builder" --work "_work" --replace
            )
            unset token
            chmod 600 "$runner_dir"/.credentials* 2>/dev/null || true

            cat > "$unit_file" <<'EOF'
[Unit]
Description=Ark GitHub Actions Self-hosted Runner
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/.local/opt/ark-github-runner
ExecStart=%h/.local/opt/ark-github-runner/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
EOF
            systemctl --user daemon-reload
            systemctl --user enable --now ark-github-runner.service
            if command -v loginctl >/dev/null 2>&1; then
                echo "Enabling user lingering so the runner can start without an interactive login."
                as_root loginctl enable-linger "$USER" ||
                    echo "Warning: enable lingering manually if the runner must start before you log in."
            fi
            echo "Runner registered with label ark-builder."
            echo "Only use this runner for trusted workflows from repositories you control."
            ;;
        disable)
            systemctl --user disable --now ark-github-runner.service
            echo "Runner stopped. Its registration is retained."
            ;;
        unregister)
            [[ -f "$runner_dir/.runner" ]] || { echo "Runner is not configured."; return; }
            read -r -s -p "Short-lived runner removal token: " token
            echo
            [[ -n "$token" ]] || { echo "A removal token is required." >&2; exit 2; }
            systemctl --user disable --now ark-github-runner.service || true
            (cd "$runner_dir" && ./config.sh remove --unattended --token "$token")
            unset token
            rm -f "$unit_file"
            systemctl --user daemon-reload
            echo "Runner unregistered. Downloaded runner files were retained."
            ;;
    esac
}

solaar_action() {
    require_command systemctl
    case "$1" in
        enable)
            require_command solaar
            systemctl --user enable --now ark-solaar.service
            ;;
        disable)
            if systemctl --user is-enabled --quiet ark-solaar.service 2>/dev/null || \
               systemctl --user is-active --quiet ark-solaar.service; then
                systemctl --user disable --now ark-solaar.service
            else
                echo "Solaar autostart is already disabled."
            fi
            ;;
        status)
            if systemctl --user is-active --quiet ark-solaar.service; then
                echo "Solaar: active for this user"
            else
                echo "Solaar: inactive (use 'lydsys solaar enable' to start it at login)"
            fi
            ;;
    esac
}

sunshine_action() {
    require_command flatpak
    require_command systemctl
    case "$1" in
        enable)
            echo "Installing Sunshine system-wide from Flathub..."
            as_root flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
            as_root flatpak install --system --noninteractive --assumeyes --or-update flathub "$APP_ID_SUNSHINE"
            systemctl --user enable --now ark-sunshine.service
            ;;
        disable)
            systemctl --user disable --now ark-sunshine.service 2>/dev/null || true
            if flatpak info --system "$APP_ID_SUNSHINE" >/dev/null 2>&1; then
                echo "Removing Sunshine. Its user configuration is retained."
                as_root flatpak uninstall --system --noninteractive --assumeyes "$APP_ID_SUNSHINE"
            else
                echo "Sunshine is not installed."
            fi
            ;;
        status)
            if flatpak info --system "$APP_ID_SUNSHINE" >/dev/null 2>&1; then
                echo "Sunshine: installed (system Flatpak)"
            else
                echo "Sunshine: not installed"
            fi
            if systemctl --user is-active --quiet ark-sunshine.service; then
                echo "Sunshine service: active"
            else
                echo "Sunshine service: inactive"
            fi
            ;;
    esac
}


printing_action() {
    require_command systemctl
    case "$1" in
        enable)
            echo "Enabling printing, printer discovery, and USB scanner support..."
            as_root systemctl enable --now cups.service avahi-daemon.service ipp-usb.service
            echo "Printing and scanning services are enabled."
            echo "Open System Settings > Printers to add a printer; use Skanpage to scan."
            ;;
        disable)
            echo "Disabling printing and scanning background services..."
            as_root systemctl disable --now ipp-usb.service avahi-daemon.service cups.service
            ;;
        status)
            for unit in cups.service avahi-daemon.service ipp-usb.service; do
                if systemctl is-active --quiet "$unit"; then
                    printf '%s: active\\n' "$unit"
                else
                    printf '%s: inactive\\n' "$unit"
                fi
            done
            ;;
        *)
            echo "Usage: lydsys printing {enable|disable|status}" >&2
            return 2
            ;;
    esac
}

run_feature() {
    local action="$1"
    local feature="$2"
    shift 2
    case "$feature" in
        development) /usr/libexec/ark/ark-development "$action" "$@" ;;
        virtualization) /usr/libexec/ark/ark-virtualization "$action" "$@" ;;
        steam) steam_action "$action" ;;
        tailscale) tailscale_action "$action" ;;
        podman) podman_action "$action" ;;
        distrobox) distrobox_action "$action" ;;
        github-runner) github_runner_action "$action" ;;
        solaar) solaar_action "$action" ;;
        sunshine) sunshine_action "$action" ;;
        printing) printing_action "$action" ;;
        *) echo "Unknown feature: $feature" >&2; usage; exit 2 ;;
    esac
}

feature_action() {
    local action="$1"
    local feature="${2:-}"
    case "$action" in
        list)
            cat <<'EOF'
Manageable:
  steam          Optional Pacman package in the Arch Distrobox
  tailscale      Optional system service
  podman         Optional rootless API socket
  github-runner  Optional repository-scoped runner service
  solaar         Optional Logitech device tray app
  sunshine       Optional game-streaming host (system Flatpak)
  printing       Optional CUPS printing and scanner discovery services
  development    Optional Distrobox toolchain plus Claude Code/Codex
  virtualization Optional local QEMU/KVM/libvirt VM host

Included in the desktop base:
  distrobox      Always available; no service toggle
EOF
            ;;
        status)
            if [[ -n "$feature" ]]; then
                run_feature status "$feature"
            else
                steam_action status
                tailscale_action status
                podman_action status
                distrobox_action status
                github_runner_action status
                solaar_action status
                sunshine_action status
                printing_action status
                /usr/libexec/ark/ark-development status
                /usr/libexec/ark/ark-virtualization status
            fi
            ;;
        enable|disable|unregister|update|shell|start|shutdown|restart|snapshot|console|gui|info|host)
            [[ -n "$feature" ]] || { echo "Specify a feature." >&2; usage; exit 2; }
            run_feature "$action" "$feature" "${@:3}"
            ;;
        *)
            usage
            exit 2
            ;;
    esac
}

if [[ $# -eq 0 ]]; then
    usage
    exit 0
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    usage
    exit 0
fi

if [[ "$1" == "feature" ]]; then
    shift
    [[ $# -ge 1 ]] || { usage; exit 2; }
    feature_action "$@"
    exit $?
fi

feature="$1"
action="${2:-status}"
case "$action" in
    status|enable|disable|unregister|update|shell|start|shutdown|restart|snapshot|console|gui|info|host|list) ;;
    *) usage; exit 2 ;;
esac

run_feature "$action" "$feature" "${@:3}"
