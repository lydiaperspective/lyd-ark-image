# Signature: emFta2FyYQ==
# Build stages are published independently and composed into the final bootable image.
ARG BASE_IMAGE=ghcr.io/lydiaperspective/lyd-ark-image:base-desktop
ARG KERNEL_IMAGE=ghcr.io/lydiaperspective/lyd-ark-image:kernel-desktop-standard

# Shared userspace base (desktop or server profile; deliberately has no kernel).
FROM docker.io/archlinux:latest AS base
ARG VARIANT=ark
ARG LYDSTORE_SHA=1bc9ddab05d8dcd82e4f0342bd921edb3aedfb57

LABEL ostree.bootable="true"
LABEL containers.bootc="1"

# Reproducibly build the bootc-aware PackageKit backend for KDE Discover.
COPY build-packagekit-bootc.sh /tmp/build-packagekit-bootc.sh
COPY patch-packagekit-bootc.py /tmp/patch-packagekit-bootc.py
COPY install-waterfox /usr/libexec/ark/install-waterfox
COPY ark-waterfox-install.service /usr/lib/systemd/system/ark-waterfox-install.service
COPY ark-solaar.service /usr/lib/systemd/user/ark-solaar.service
COPY ark-sunshine.service /usr/lib/systemd/user/ark-sunshine.service
COPY ark-development /usr/libexec/ark/ark-development
COPY ark-virtualization /usr/libexec/ark/ark-virtualization

# Ensure libvirt's encrypted-secret key destination exists before its first-boot generator runs.
RUN mkdir -p /usr/lib/systemd/system/virt-secret-init-encryption.service.d && \
    printf '%s\n' '[Service]' 'ExecStartPre=/usr/bin/install -d -m 0700 -o root -g root /var/lib/libvirt/secrets' > /usr/lib/systemd/system/virt-secret-init-encryption.service.d/10-ark-secret-directory.conf

# Layer 1: Base system packages (no kernel — variant-independent)
RUN set -e; \
    sed -i '/NoExtract/d' /etc/pacman.conf && \
    printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf; \
    pacman -Syu --noconfirm; \
    if [[ "$VARIANT" == "intel3-server-lts" ]]; then \
        pacman -S --noconfirm \
            base glibc inetutils linux-firmware networkmanager mkinitcpio openssh tailscale \
            cockpit cockpit-podman cockpit-storaged cockpit-files cockpit-machines cockpit-pacman \
            udisks2 pcp \
            tuned tuned-ppd \
            util-linux openssl efibootmgr dosfstools e2fsprogs xfsprogs ostree skopeo rclone fuse3 python-pip python-setuptools python-fastapi uvicorn ntfs-3g exfatprogs \
            btrfs-progs snapper snap-pac podman podman-compose distrobox composefs shadow sudo git nano zsh fish python rsync acl \
            qemu-full libvirt dnsmasq iptables-nft edk2-ovmf swtpm \
            fuse2 squashfuse libappimage desktop-file-utils shared-mime-info \
            slirp4netns passt fuse-overlayfs catatonit; \
    else \
        pacman -S --noconfirm \
            base glibc inetutils linux-firmware networkmanager mkinitcpio tailscale \
            plasma-meta plasma-desktop plasma-workspace kscreen kdialog plasma-nm plasma-pa plasma-integration polkit-kde-agent breeze breeze-cursors breeze-icons \
            plasma-workspace-wallpapers plymouth-kcm \
            plasma-systemmonitor powerdevil systemsettings plasma-login-manager konsole dolphin ark libarchive okular kate solaar \
            spectacle partitionmanager kde-gtk-config breeze-gtk xdg-desktop-portal-kde \
            xdg-desktop-portal xdg-user-dirs xdg-utils kio-admin kwalletmanager kwallet-pam \
            flatpak discover packagekit packagekit-qt6 bluez bluez-utils bluedevil wpa_supplicant print-manager cups cups-filters sane sane-airscan skanpage ipp-usb avahi \
            gcc meson ninja pkgconf \
            tuned tuned-ppd \
            webp-pixbuf-loader libheif libavif libraw ffmpegthumbnailer poppler-glib libgsf \
            util-linux openssl efibootmgr dosfstools e2fsprogs xfsprogs ostree skopeo rclone fuse3 python-pip python-setuptools python-fastapi uvicorn ntfs-3g exfatprogs \
            btrfs-progs snapper snap-pac podman podman-compose distrobox composefs ibus iso-codes shadow sudo git curl jq icu libunwind krb5 lttng-ust nano zsh fish python rsync acl libnotify \
            qemu-full libvirt virt-manager virt-viewer spice-gtk dnsmasq iptables-nft edk2-ovmf swtpm \
            fuse2 squashfuse libappimage desktop-file-utils shared-mime-info \
            slirp4netns passt fuse-overlayfs catatonit; \
        chmod 0755 /tmp/build-packagekit-bootc.sh; \
        bash /tmp/build-packagekit-bootc.sh; \
        # Keep PackageKit's bootc backend for system updates, but remove the
        # Arch ALPM backend so Discover cannot offer Arch repository packages.
        rm -f /usr/lib/packagekit-backend/libpk_backend_alpm.so; \
        test -s /usr/lib/packagekit-backend/libpk_backend_bootc.so; \
        if [[ -e /usr/lib/packagekit-backend/libpk_backend_alpm.so ]]; then \
            echo "ERROR: Arch ALPM PackageKit backend is still installed." >&2; \
            exit 1; \
        fi; \
        pacman -Rns --noconfirm gcc meson ninja pkgconf; \
    fi; \
    # Distrobox 1.8.2.5 emits invalid :ro:rslave syntax with Podman; apply upstream PR #2086. \
    if grep -Fq 'rslave=":rslave"' /usr/bin/distrobox-create && \
       ! grep -Fq 'rorslave=":ro,rslave"' /usr/bin/distrobox-create; then \
        sed -i \
            -e '/rslave=""/a\\        rorslave=":ro"' \
            -e '/rslave=":rslave"/a\\        rorslave=":ro,rslave"' \
            -e 's/:ro${rslave}/${rorslave}/' \
            /usr/bin/distrobox-create; \
    fi; \
    if grep -Fq ':ro${rslave}' /usr/bin/distrobox-create || \
       ! grep -Fq 'rorslave=":ro,rslave"' /usr/bin/distrobox-create || \
       ! grep -Fq '${rorslave}' /usr/bin/distrobox-create; then \
        echo "ERROR: Distrobox read-only slave mount compatibility patch failed." >&2; \
        exit 1; \
    fi; \
    bash -n /usr/bin/distrobox-create; \
    rm -f /tmp/build-packagekit-bootc.sh /tmp/patch-packagekit-bootc.py; \
    sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen; \
    echo "LANG=en_US.UTF-8" > /etc/locale.conf; \
    ln -sf /usr/share/zoneinfo/UTC /etc/localtime; \
    chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap; \
    echo "arklinux" > /etc/hostname; \
    if [[ "$VARIANT" != "intel3-server-lts" ]]; then \
        pacman -Q ark libarchive || { echo "ERROR: KDE Ark ZIP archive support is missing." >&2; exit 1; }; \
        for pkg in plasma-nm bluez bluez-utils bluedevil wpa_supplicant print-manager cups cups-filters sane sane-airscan skanpage ipp-usb avahi; do \
            pacman -Q "$pkg" >/dev/null || { echo "ERROR: printing/scanning package missing: $pkg" >&2; exit 1; }; \
        done; \
        for unit in NetworkManager.service bluetooth.service cups.service avahi-daemon.service ipp-usb.service; do \
            test -f "/usr/lib/systemd/system/$unit" || { echo "ERROR: printing/scanning unit missing: $unit" >&2; exit 1; }; \
        done; \
        # Keep the desktop profile KDE-only; batch-remove GNOME utilities \
        # if they arrive as dependencies of the selected package set. \
        unwanted_gnome=(nuttyimgconverter nautilus-python nautilus gnome-system-monitor gnome-disk-utility gnome-disk-utility-git); \
        installed_gnome="$(pacman -Qq)"; \
        remove_gnome=(); \
        for pkg in "${unwanted_gnome[@]}"; do \
            if grep -Fxq -- "$pkg" <<< "$installed_gnome"; then remove_gnome+=("$pkg"); fi; \
        done; \
        if (("${#remove_gnome[@]}")); then pacman -Rns --noconfirm "${remove_gnome[@]}"; fi; \
        for pkg in "${unwanted_gnome[@]}"; do \
            if pacman -Q "$pkg" >/dev/null 2>&1; then \
                echo "ERROR: unwanted GNOME application remains installed: $pkg" >&2; \
                exit 1; \
            fi; \
        done; \
        if pacman -Q sddm >/dev/null 2>&1; then \
            echo "ERROR: SDDM must not be present in Lyd Ark desktop images." >&2; \
            exit 1; \
        fi; \
        if ! pacman -Q plasma-login-manager >/dev/null 2>&1; then \
            echo "ERROR: Plasma Login Manager is missing from the desktop image." >&2; \
            exit 1; \
        fi; \
    fi; \
    pacman -Scc --noconfirm


# PackageKit clears its environment before launching backend helpers by default.
# Keep the service environment so the bootc backend can locate Podman and receive
# BOOTC_EXP_EXTERNAL_CONTAINER_TOOL when Discover checks for OS updates.
RUN if [[ "$VARIANT" != "intel3-server-lts" ]]; then \
        mkdir -p /usr/lib/systemd/system/packagekit.service.d && \
        printf '%s\n' \
            '[Service]' \
            'Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"' \
            'Environment="BOOTC_EXP_EXTERNAL_CONTAINER_TOOL=/usr/bin/podman"' \
            'ExecStart=' \
            'ExecStart=/usr/lib/packagekitd --keep-environment' \
            > /usr/lib/systemd/system/packagekit.service.d/20-bootc-environment.conf; \
    fi
# Layer 1b: First-boot account setup. The live installer does not collect,
# store, or write account credentials. The installed system prompts on tty1.
COPY create-initial-account /usr/libexec/ark/create-initial-account
COPY ark-initial-account.service /usr/lib/systemd/system/ark-initial-account.service
COPY ark-initial-account-server.service /usr/lib/systemd/system/ark-initial-account-server.service
RUN chmod 0755 /usr/libexec/ark/create-initial-account && \
    if [[ "$VARIANT" == "intel3-server-lts" ]]; then \
        install -m 0644 /usr/lib/systemd/system/ark-initial-account-server.service /usr/lib/systemd/system/ark-initial-account.service && \
        systemctl enable ark-initial-account.service getty@tty1.service && \
        systemctl mask display-manager.service plasmalogin.service; \
    else \
        systemctl enable ark-initial-account.service && \
        mkdir -p /usr/lib/systemd/system/plasmalogin.service.d && \
        printf '%s\n' '[Unit]' 'Requires=ark-initial-account.service' 'After=ark-initial-account.service' > /usr/lib/systemd/system/plasmalogin.service.d/10-ark-first-boot.conf; \
    fi

# Layer 2: OSTree sysroot + systemd services
RUN set -e; \
    if [[ "$VARIANT" == "intel3-server-lts" ]]; then \
        systemctl enable NetworkManager tuned tuned-ppd sshd cockpit.socket libvirtd.service tailscaled.service; \
        systemctl mask systemd-networkd-wait-online.service; \
        mkdir -p /etc/ssh/sshd_config.d; \
        printf 'PasswordAuthentication yes\nPubkeyAuthentication yes\nPermitRootLogin no\n' > /etc/ssh/sshd_config.d/10-ark-server.conf; \
    else \
        chmod 0755 /usr/libexec/ark/install-waterfox; \
        systemctl enable plasmalogin NetworkManager.service bluetooth.service tuned tuned-ppd tailscaled.service ark-waterfox-install.service; \
        glib-compile-schemas /usr/share/glib-2.0/schemas/; \
    fi; \
    mkdir -p /etc/sudoers.d; \
    printf '%s\n' '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel; \
    chmod 0440 /etc/sudoers.d/10-wheel; \
    visudo -cf /etc/sudoers; \
    grep -q 'pam_mkhomedir.so' /etc/pam.d/system-login || \
        printf 'session required pam_mkhomedir.so skel=/etc/skel umask=0077\n' >> /etc/pam.d/system-login; \
    systemctl mask systemd-firstboot.service; \
    mkdir -p /etc/ostree; \
    mkdir -p /sysroot /sysroot/ostree /.snapshots; \
    ln -sfn sysroot/ostree /ostree

# Plasma Login Manager uses its normal login prompt; no autologin configuration is installed.

# Layer 3: bootupd + home/root symlinks
RUN [ -f /usr/libexec/bootupd ] && chmod +x /usr/libexec/bootupd /usr/bin/bootupctl || true; \
    rm -rf /home /root && \
    ln -sf var/home /home && \
    ln -sf var/roothome /root

# Layer 4: Prepare /var/nix (nix subvolume target; nix itself installed in Layer 11 from AUR)
RUN mkdir -p /var/nix

# Layer 5: BLS sync
COPY bls-sync.sh /usr/libexec/ark/bls-sync.sh
COPY bls-sync.conf /usr/lib/systemd/system/ostree-finalize-staged.service.d/bls-sync.conf
COPY bls-sync.conf /usr/lib/systemd/system/bootc-finalize-staged.service.d/bls-sync.conf
COPY ark-bls-sync.service /usr/lib/systemd/system/ark-bls-sync.service
RUN chmod +x /usr/libexec/ark/bls-sync.sh && \
    systemctl enable ark-bls-sync.service

# Install the standalone Lyd Ark storage manager on desktop and server images.
RUN set -e; \
    git clone --quiet https://github.com/lydiaperspective/lyd-ark-storage-manager.git /tmp/lyd-ark-storage-manager; \
    git -C /tmp/lyd-ark-storage-manager checkout --quiet "$LYDSTORE_SHA"; \
    python -m pip install --break-system-packages --no-build-isolation --no-deps /tmp/lyd-ark-storage-manager; \
    rm -rf /tmp/lyd-ark-storage-manager; \
    grep -q '^user_allow_other' /etc/fuse.conf || printf '\\nuser_allow_other\\n' >> /etc/fuse.conf; \
    lydstore --help; \
    systemctl enable lydstore-web.service

# Layer 5b: Standardized Lyd Ark storage paths and shared admin access.
COPY ark-storage.sysusers /usr/lib/sysusers.d/ark-storage.conf
COPY ark-storage.tmpfiles /usr/lib/tmpfiles.d/ark-storage.conf
RUN systemd-sysusers /usr/lib/sysusers.d/ark-storage.conf

# Layer 6: Orundum (container storage subvolume)
COPY ark-orundum.conf /usr/lib/tmpfiles.d/ark-orundum.conf
RUN mkdir -p /orundum /etc/skel/.local/share

# Layer 6b: Shared writable directories for all users
COPY ark-share.conf /usr/lib/tmpfiles.d/ark-share.conf
COPY ark-games.conf /usr/lib/tmpfiles.d/ark-games.conf
COPY ark-log-user.conf /usr/lib/tmpfiles.d/ark-log-user.conf
COPY ark-flatpak.conf /usr/lib/tmpfiles.d/ark-flatpak.conf
COPY ark-containers.conf /usr/lib/tmpfiles.d/ark-containers.conf
RUN mkdir -p /etc/skel/.local/share/{applications,fonts,icons,themes,backgrounds,sounds} && \
    mkdir -p /etc/profile.d && \
    printf 'export XDG_DATA_DIRS=/var/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share\n' > /etc/profile.d/ark-share.sh

# Layer 6c: Bind mount /var/share into user home directories
COPY ark-bindmounts /usr/lib/ark/ark-bindmounts
COPY ark-bindmounts-pam /usr/lib/ark/ark-bindmounts-pam
COPY ark-bindmounts.service /usr/lib/systemd/system/ark-bindmounts.service
COPY ark /usr/bin/lydsys
COPY ark-mimeapps.list /etc/xdg/mimeapps.list
RUN if [[ "$VARIANT" == "intel3-server-lts" ]]; then \
        rm -f /usr/bin/ark /etc/xdg/mimeapps.list; \
    else \
        bash -n /usr/bin/lydsys; \
        test -x /usr/bin/ark; \
        chmod 0755 /usr/bin/lydsys /usr/libexec/ark/ark-development /usr/libexec/ark/ark-virtualization; \
    fi; \
    chmod +x /usr/lib/ark/ark-bindmounts /usr/lib/ark/ark-bindmounts-pam && \
    systemctl enable ark-bindmounts.service && \
    { grep -q 'pam_exec.so.*ark-bindmounts-pam' /etc/pam.d/system-login 2>/dev/null || \
      echo 'session optional pam_exec.so /usr/lib/ark/ark-bindmounts-pam' >> /etc/pam.d/system-login; }

# Persistent agent workspaces, provisioning, and desktop entry points.
COPY agents/storage.py /usr/libexec/ark/agents-storage
COPY agents/cli.py /usr/bin/ark-agent
COPY agents/ark-agents-storage.service /usr/lib/systemd/system/ark-agents-storage.service
COPY agents/ark-agents.policy /usr/share/polkit-1/actions/org.arklinux.agents.policy
COPY agents/ark-agent.desktop /usr/share/applications/org.arklinux.Agent.desktop
COPY agents/ark-agents-setup.desktop /etc/xdg/autostart/org.arklinux.AgentSetup.desktop
COPY agents/skills /usr/share/agents/skills
RUN mkdir -p /agents && \
    chmod 0755 /usr/libexec/ark/agents-storage /usr/bin/ark-agent && \
    systemctl enable ark-agents-storage.service

# Layer 7: Hostname sync
COPY ark-hostname-sync.sh /usr/lib/ark/ark-hostname-sync
COPY ark-hostname-sync.service /usr/lib/systemd/system/ark-hostname-sync.service
COPY ark-hostname-sync.path /usr/lib/systemd/system/ark-hostname-sync.path
RUN chmod +x /usr/lib/ark/ark-hostname-sync && \
    systemctl enable ark-hostname-sync.path

# Layer 8: carrier + PM symlinks + ark-home
ARG CARRIER_SHA=unknown
ARG CARRIER_URL=https://github.com/zamkara/carrier-pkg/releases/latest/download/carrier
RUN echo "Carrier release: $CARRIER_SHA" && \
    curl -fSL --retry 3 --connect-timeout 15 --max-time 180 "$CARRIER_URL" \
    -o /usr/lib/ark/carrier && \
    chmod +x /usr/lib/ark/carrier && \
    /usr/lib/ark/carrier --version
COPY ark-home.conf /usr/lib/tmpfiles.d/ark-home.conf
RUN ln -sf /usr/lib/ark/carrier /usr/local/bin/pacman && \
    ln -sf /usr/lib/ark/carrier /usr/local/bin/apt-get && \
    ln -sf /usr/lib/ark/carrier /usr/local/bin/apt && \
    ln -sf /usr/lib/ark/carrier /usr/local/bin/dnf && \
    ln -sf /usr/lib/ark/carrier /usr/local/bin/yum && \
    ln -sf /usr/lib/ark/carrier /usr/local/bin/zypper && \
    ln -sf /usr/lib/ark/carrier /usr/local/bin/apk && \
    ln -sf /usr/lib/ark/carrier /usr/local/bin/emerge && \
    ln -sf /usr/lib/ark/carrier /usr/local/bin/xbps-install && \
    ln -sf /usr/lib/ark/carrier /usr/local/bin/slackpkg && \
    ln -sf /usr/lib/ark/carrier /usr/local/bin/opkg

# Layer 9: Alga wrapper + desktop entry + D-Bus + update timer
COPY alga-wrapper.sh /usr/lib/ark/alga-wrapper
COPY com.zamkara.alga.service /usr/share/dbus-1/services/com.zamkara.alga.service
COPY alga-update.service /usr/lib/systemd/system/alga-update.service
COPY alga-update.timer /usr/lib/systemd/system/alga-update.timer
RUN chmod +x /usr/lib/ark/alga-wrapper && \
    systemctl enable alga-update.timer

# Layer 9a: bootc updates track the final image reference recorded at install time.
COPY ark-bootc-update.service /usr/lib/systemd/system/ark-bootc-update.service
COPY ark-bootc-update.timer /usr/lib/systemd/system/ark-bootc-update.timer
COPY ark-os-update /usr/bin/ark-os-update
RUN chmod 0755 /usr/bin/ark-os-update && \
    systemctl enable ark-bootc-update.timer

# Layer 9b: MoreWaita folder icons autostart
COPY ark-folder-icons.sh /usr/libexec/ark/ark-folder-icons.sh
COPY ark-folder-icons.desktop /etc/xdg/autostart/ark-folder-icons.desktop
RUN chmod +x /usr/libexec/ark/ark-folder-icons.sh

# Layer 10: /usr/local → /var/usrlocal symlink
RUN rm -rf /usr/local && ln -sf ../var/usrlocal /usr/local

# Kernel stage: add one kernel family to a published base userspace image.
FROM ${BASE_IMAGE} AS kernel
ARG VARIANT

# Layer 11: Kernel + AUR packages + DKMS (variant-specific)
ARG AUR_SHA=unknown
COPY install-packages.sh /usr/lib/ark/install-packages.sh
RUN --mount=type=bind,source=aur-packages,target=/tmp/aur-packages \
    set -e; \
    echo "AUR SHA: ${AUR_SHA}"; \
    KERNEL="linux"; \
    CACHY_KERNEL=""; \
    if [[ "$VARIANT" == *"-apex"* ]]; then \
        CACHY_KERNEL="linux-cachyos"; \
        if [[ "$VARIANT" == *"-bore"* ]]; then CACHY_KERNEL="linux-cachyos-bore"; fi; \
        if [[ "$VARIANT" == *"-lts"* ]]; then CACHY_KERNEL="linux-cachyos-lts"; fi; \
        if [[ "$VARIANT" == *"-hardened"* ]]; then CACHY_KERNEL="linux-cachyos-hardened"; fi; \
        if ! grep -q '^\\[cachyos\\]' /etc/pacman.conf; then \
            printf '\n[cachyos]\nSigLevel = Never\nServer = https://mirror.cachyos.org/repo/$arch/$repo\n' >> /etc/pacman.conf; \
        fi; \
        pacman-key --init; \
        pacman -Sy --noconfirm cachyos-keyring; \
        pacman-key --populate cachyos; \
        sed -i '/SigLevel = Never/d' /etc/pacman.conf; \
        pacman -Sy --noconfirm; \
        # CachyOS LTO headers require pahole >= 1:1.32-2; Arch extra may lag behind. \
        pacman -S --noconfirm cachyos/pahole; \
        pacman -Syu --noconfirm $CACHY_KERNEL ${CACHY_KERNEL}-headers; \
    else \
        if [[ "$VARIANT" == *"-zen"* ]]; then KERNEL="linux-zen"; fi; \
        if [[ "$VARIANT" == *"-lts"* ]]; then KERNEL="linux-lts"; fi; \
        if [[ "$VARIANT" == *"-hardened"* ]]; then KERNEL="linux-hardened"; fi; \
        pacman -S --noconfirm $KERNEL ${KERNEL}-headers; \
    fi; \
    VARIANT="$VARIANT" bash /usr/lib/ark/install-packages.sh; \
    locale-gen; \
    KVER=$(ls -1 /usr/lib/modules | grep -v extramodules | head -n1); \
    dkms autoinstall -k "$KVER"; \
    pacman -Scc --noconfirm; \
    rm -f /var/usrlocal/bin/pacman; \
    systemd-sysusers; \
    mkdir -p /nix/var /etc/nix; \
    rm -rf /nix/var/nix; \
    ln -sf /var/nix /nix/var/nix; \
    echo "experimental-features = nix-command flakes" >> /etc/nix/nix.conf; \
    echo "trusted-users = root @wheel" >> /etc/nix/nix.conf; \
    echo "extra-nix-path = nixpkgs=channel:nixpkgs-unstable" >> /etc/nix/nix.conf; \
    systemctl enable nix-daemon.socket nix-daemon.service || true

# NVIDIA power management config (inert on non-nvidia variants)
COPY nvidia-pm.conf /etc/modprobe.d/nvidia.conf
COPY 80-nvidia-pm.rules /usr/lib/udev/rules.d/80-nvidia-pm.rules

# Driver stage: add optional GPU drivers to the selected kernel image.
# The initramfs is generated only after this stage so it contains the final driver modules.
FROM ${KERNEL_IMAGE} AS final
ARG VARIANT

# Layer 12: Nvidia (variant-specific, must be before mkinitcpio)
RUN set -e; \
    if [[ "$VARIANT" == *"-nvidia-580" ]]; then \
        # The legacy proprietary 580xx stack is sourced only from CachyOS.
        # Remove standard NVIDIA packages inherited from the kernel image first;
        # they conflict with the matching 580xx userspace packages.
        conflicting_nvidia=(); \
        for pkg in nvidia-open-dkms nvidia-utils nvidia-settings lib32-nvidia-utils; do \
            if pacman -Q "$pkg" >/dev/null 2>&1; then conflicting_nvidia+=("$pkg"); fi; \
        done; \
        if ((${#conflicting_nvidia[@]})); then pacman -Rdd --noconfirm "${conflicting_nvidia[@]}"; fi; \
        # Bootstrap the CachyOS signing key before installing the driver stack.
        printf '\n[cachyos]\nSigLevel = Never\nServer = https://mirror.cachyos.org/repo/$arch/$repo\n' >> /etc/pacman.conf; \
        pacman-key --init; \
        pacman -Sy --noconfirm cachyos-keyring; \
        pacman-key --populate cachyos; \
        sed -i '/SigLevel = Never/d' /etc/pacman.conf; \
        pacman -Sy --noconfirm; \
        pacman -S --noconfirm nvtop dkms \
            cachyos/nvidia-580xx-dkms cachyos/nvidia-580xx-utils \
            cachyos/nvidia-580xx-settings cachyos/lib32-nvidia-580xx-utils; \
        KVER=$(ls -1 /usr/lib/modules | grep -v extramodules | head -n1); \
        dkms autoinstall -k "$KVER"; \
        pacman -Q nvidia-580xx-dkms nvidia-580xx-utils nvidia-580xx-settings lib32-nvidia-580xx-utils; \
        grep -Eq '^options nvidia_drm modeset=1([[:space:]]|$)' /etc/modprobe.d/nvidia.conf; \
        # Do not leave CachyOS enabled in the installed system.
        sed -i '/^\[cachyos\]/,/^$/d' /etc/pacman.conf; \
        pacman -Scc --noconfirm; \
    elif [[ "$VARIANT" == *"-nvidia"* ]]; then \
        # Existing NVIDIA variants continue to use Arch's open DKMS driver.
        pacman -S --noconfirm nvtop extra/nvidia-open-dkms \
            extra/nvidia-utils extra/nvidia-settings multilib/lib32-nvidia-utils dkms; \
        KVER=$(ls -1 /usr/lib/modules | grep -v extramodules | head -n1); \
        dkms autoinstall -k "$KVER"; \
        pacman -Scc --noconfirm; \
    fi

# Layer 12b: ASUS packages (variant-specific)
# supergfxctl excluded intentionally — deprecated upstream, removed from dependency tree in commit
# 04e59f7 (2026-06-16). GPU detection + power monitoring moved to asusd natively.
# For apex-ASUS, packages come from CachyOS (repo configured in Layer 11).
# For zen-ASUS, packages come from the g14 repo.
RUN set -e; \
    if [[ "$VARIANT" == *"-asus"* ]]; then \
        if [[ "$VARIANT" != *"-apex"* ]]; then \
            printf '\n[g14]\nSigLevel = Never\nServer = https://arch.asus-linux.org\n' >> /etc/pacman.conf; \
        fi; \
        pacman -Syu --noconfirm asusctl rog-control-center; \
        pacman -Scc --noconfirm; \
    fi

# Layer 12c: Wicca Plymouth theme for desktop images. Convert SVG artwork to PNG for Plymouth's script Image() loader.
RUN set -e; if [[ "$VARIANT" != "intel3-server-lts" ]]; then pacman -S --noconfirm librsvg; command -v rsvg-convert >/dev/null; git clone --quiet https://github.com/lydiaperspective/lyd-ark-themes.git /tmp/lyd-ark-themes; git -C /tmp/lyd-ark-themes checkout --quiet 5f0571e08d36a976a64d3b2f51019fdbf955ee3f; install -d /usr/share/plymouth/themes/lyd-ark-wicca; cp -a /tmp/lyd-ark-themes/themes/wicca/plymouth/. /usr/share/plymouth/themes/lyd-ark-wicca/; for asset in /usr/share/plymouth/themes/lyd-ark-wicca/*.svg; do rsvg-convert "$asset" > "/usr/share/plymouth/themes/lyd-ark-wicca/$(basename "$asset" .svg).png"; done; rm /usr/share/plymouth/themes/lyd-ark-wicca/*.svg; plymouth-set-default-theme lyd-ark-wicca; test -s /usr/share/plymouth/themes/lyd-ark-wicca/lyd-ark-wicca.script; test -s /etc/plymouth/plymouthd.conf; grep -Fq Theme=lyd-ark-wicca /etc/plymouth/plymouthd.conf; for asset in /usr/share/plymouth/themes/lyd-ark-wicca/*.png; do test -s "$asset"; done; rm -rf /tmp/lyd-ark-themes; fi
# Layer 13: mkinitcpio + initramfs cleanup
RUN set -e; \
    sed -i 's/^MODULES=.*/MODULES=(btrfs vfat ext4 xfs erofs overlay loop)/g' /etc/mkinitcpio.conf && \
    sed -i 's/^HOOKS=.*/HOOKS=(base systemd microcode modconf kms keyboard sd-vconsole block sd-encrypt plymouth ostree filesystems fsck)/g' /etc/mkinitcpio.conf && \
    mkinitcpio -P && \
    KVER=$(ls -1 /usr/lib/modules | grep -v 'extramodules' | head -n 1) && \
    IMG=$(ls -1 /boot/initramfs-*.img | grep -v 'fallback' | head -n 1) && \
    cp $IMG /usr/lib/modules/$KVER/initramfs.img && \
    rm -rf /boot/* /var/lib/pacman/sync/* /var/log/* /tmp/* /usr/share/doc/* /usr/share/man/* /usr/share/info/*

# Layer 14: Remove pacman + cleanup unwanted desktop entries
RUN rm -rf \
        /usr/bin/pacman* \
        /usr/bin/makepkg* \
        /usr/bin/repo-add \
        /usr/bin/repo-elephant \
        /usr/bin/repo-remove \
        /usr/bin/testpkg \
        /usr/bin/vercmp \
        /usr/lib/libalpm.so* \
        /usr/include/alpm* \
        /usr/lib/pkgconfig/libalpm.pc \
        /usr/lib/systemd/system/sockets.target.wants/dirmngr@etc-pacman.d-gnupg.socket \
        /usr/lib/systemd/system/sockets.target.wants/gpg-agent*@etc-pacman.d-gnupg.socket \
        /usr/lib/systemd/system/sockets.target.wants/keyboxd@etc-pacman.d-gnupg.socket \
        /usr/share/bash-completion/completions/pacman* \
        /usr/share/bash-completion/completions/makepkg* \
        /usr/share/zsh/site-functions/_pacman* \
        /usr/share/man/man8/pacman* \
        /usr/share/man/man8/makepkg* \
        /usr/share/man/man8/repo-* \
        /usr/share/man/man8/vercmp* \
        /usr/share/man/man8/testpkg* \
        /etc/pacman.conf \
        /etc/pacman.d/ \
        /var/lib/pacman/ && \
    rm -f /usr/share/applications/{bssh,bvnc,avahi-discover,qv4l2,qvidcap,stoken-gui,stoken-gui-small,org.gnome.Extensions,org.gnome.TextEditor,lstopo,hwloc-ls,org.gnome.Logs,ibus,ibus-setup,ibus-wayland,scrcpy,scrcpy-console,veracrypt,timeshift,timeshift-gtk,org.freedesktop.MalcontentControl,nvtop}.desktop 2>/dev/null || true; \
    if [[ "$VARIANT" != "intel3-server-lts" ]]; then \
        # Discover depends on Arch's AppStream catalogue even when ALPM is absent. \
        # Remove that catalogue so only Flatpak supplies installable applications. \
        rm -rf /usr/share/swcatalog; \
        test ! -e /usr/share/swcatalog; \
        test -s /usr/lib/qt6/plugins/discover/flatpak-backend.so; \
        test -s /usr/lib/packagekit-backend/libpk_backend_bootc.so; \
        test ! -e /usr/lib/packagekit-backend/libpk_backend_alpm.so; \
    fi

# Runtime state is recreated at boot; keep builder-injected mounts intact.
COPY clean-runtime.py /usr/lib/ark/clean-runtime.py
RUN python /usr/lib/ark/clean-runtime.py
